FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8080/auth/facebook/callback
FACEBOOK_VERIFY_TOKEN=

TIKTOK_API_KEY=
TIKTOK_SESSION_PATH=
